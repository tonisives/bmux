{
  "name": "bmux-remote",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "expo start --max-workers 4",
    "web": "expo start --web --port 1943 --max-workers 4",
    "export:web": "expo export --platform web --max-workers 4",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify:ios": "node scripts/verify-ios-scenes.mjs && node scripts/verify-ios-metro.mjs",
    "smoke:ios": "node scripts/ios-launch-smoke.mjs",
    "smoke:ios:launcher": "node scripts/ios-launcher-smoke.mjs",
    "test": "vitest run --maxWorkers=4",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-reserved-regions": "0.2.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^155.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
