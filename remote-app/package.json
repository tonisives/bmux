{
  "name": "bmux-remote",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "expo start --max-workers 4",
    "web": "expo start --web --port 1943 --max-workers 4",
    "export:web": "expo export --platform web --max-workers 4",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify:ios": "node scripts/verify-ios-scenes.mjs",
    "smoke:ios": "node scripts/ios-launch-smoke.mjs",
    "test": "vitest run --maxWorkers=4",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^155.0.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
