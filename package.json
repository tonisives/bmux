{
  "name": "bmux",
  "version": "0.1.0",
  "description": "A Chromium browser with tmux-style sessions and isolated profiles",
  "author": "bmux contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "bmux": "bin/bmux.mjs",
    "brmux": "bin/bmux.mjs"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "site:dev": "vite --config website/vite.config.ts",
    "site:build": "node website/build.mjs",
    "site:preview": "vite preview --config website/vite.config.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=4",
    "test:electron": "pnpm build && playwright test --workers=1",
    "package": "pnpm build && electron-builder --mac --dir && node scripts/install-app.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:package": "node scripts/smoke-packaged.mjs",
    "test:ui": "pnpm build && node scripts/check-ui.mjs",
    "debug:ui": "pnpm build && node scripts/check-ui.mjs --keep-open",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.18.2",
    "darkreader": "^4.9.130",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "5.0.0",
    "eslint": "^9.0.0",
    "ti-reactu": "^1.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "bmux.tonis.dev",
    "productName": "bmux",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "bin/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "examples/plugins",
        "to": "plugins"
      },
      {
        "from": "bundled-plugins",
        "to": "bundled-plugins"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Allow websites you approve to use the camera.",
        "NSMicrophoneUsageDescription": "Allow websites you approve to use the microphone."
      },
      "icon": "build/icon.icns"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
